# Template pra 2ª instância do ERIS - papel "musica" (2026-08-26, pedido do
# usuário: "esse novo bot devo fazer p ERIS? O primeiro é da GAIA" -> sim,
# 2ª instância do MESMO projeto, bot Discord PRÓPRIO). Copie pra `.env.musica`
# (nunca commitado - `.gitignore` cobre `.env.*`) e rode com
# `python -m eris.main musica` (sem o argumento "musica", sobe o papel
# "completo" de sempre, lendo `.env`).
#
# Por quê uma instância separada: uma conta de bot Discord só consegue 1
# conexão de voz POR SERVIDOR - pra tocar música (Modo Música) e ao mesmo
# tempo continuar disponível pro Modo Conversa/Intérprete/Tutora no MESMO
# canal, precisa de 2 contas de bot distintas (mesmo motivo pelo qual o
# Jockie Music usa 4 aplicações separadas - Jockie Music, Music 1/2/3).

# Token do bot de MÚSICA - aplicação PRÓPRIA no Portal de Desenvolvedores
# (https://discord.com/developers/applications), diferente da aplicação
# principal da GAIA. Intent necessária (aba "Bot" -> "Privileged Gateway
# Intents"): nenhuma privilegiada é exigida (papel "musica" não lê mensagens
# nem lista membros - só voz e slash commands).
DISCORD_BOT_TOKEN=

# Onde a GAIA escuta o webhook reverso - usado só pra pedir a PRÓXIMA música
# (continuação "mesma vibe" via ECHO, `eris/integrations/gaia_webhook.py::
# pedir_proxima_musica`). Ajuste só se a GAIA rodar noutra porta/máquina.
GAIA_WEBHOOK_URL=http://127.0.0.1:8766

# Caminho pro binário do ffmpeg/ffprobe (opcional) - toca a música na call.
# Sem configurar, cai pro PATH do sistema. Ver `.env.example` (mesma variável,
# instância "completo").
FFMPEG_BIN_DIR=

# Caminho pro arquivo de cookies do YouTube (opcional) - só necessário se a
# busca parar de funcionar por bloqueio de bot. Ver `.env.example` pro guia
# completo de como gerar.
YOUTUBE_COOKIES_FILE=
