# Token do bot do Discord - obrigatório, sem ele o ERIS não conecta.
# Portal de Desenvolvedores (https://discord.com/developers/applications) ->
# "New Application" -> aba "Bot" -> "Reset Token" -> copie o valor. Trate como
# senha - dá controle total sobre o bot. Intents necessárias (mesma aba
# "Bot", seção "Privileged Gateway Intents"): MESSAGE CONTENT INTENT e SERVER
# MEMBERS INTENT (a última é exigida pra moderação de membros - kick/ban/
# timeout/cargo - sem ela, o bot nem enxerga a lista de membros do servidor).
DISCORD_BOT_TOKEN=

# IDs de conta do Discord com acesso total (não é o ID do bot!) - lista inicial
# só pra bootstrap; depois disso, a lista real (com nome + toggle ativo/
# inativo por conta) é editada no Painel da GAIA e vive no banco do próprio
# ERIS (data/eris.db), não mais aqui. Ative o Modo de Desenvolvedor (Discord ->
# Configurações -> Avançado), clique com o botão direito no seu nome -> "Copiar
# ID do Usuário". Separe várias contas por vírgula.
DISCORD_OWNER_IDS=

# Onde a GAIA escuta o webhook reverso (mensagem recebida, comando invocado)
# pra decidir o que a persona responde - o ERIS nunca gera conteúdo, só
# executa a entrega. Ajuste só se a GAIA rodar noutra porta/máquina.
GAIA_WEBHOOK_URL=http://127.0.0.1:8766

# Caminho pro binário do ffmpeg/ffprobe (opcional) - usado pra converter áudio
# em mensagem de voz nativa do Discord (a bolha com waveform) E pra tocar
# música na call (Modo Música, `eris/core/musica.py`). Sem configurar, cai
# pro PATH do sistema.
FFMPEG_BIN_DIR=

# Caminho pro arquivo de cookies exportado do navegador (opcional, Modo
# Música) - só necessário se a busca no YouTube parar de funcionar por bloqueio
# de bot (o padrão, sem isso, já usa o client "android" do yt-dlp, que
# historicamente não exige cookie). Se precisar: instale a extensão "Get
# cookies.txt" no navegador, exporte os cookies de youtube.com numa janela
# anônima/privada (feche a janela depois, pra não invalidar a sessão),
# aponte aqui pro arquivo .txt gerado.
YOUTUBE_COOKIES_FILE=
